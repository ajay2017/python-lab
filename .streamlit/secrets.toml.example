# Copy this file to .streamlit/secrets.toml and fill in your actual values.
# NEVER commit secrets.toml to git — it is already in .gitignore.
#
# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
#
[supabase]
url = "https://your-project-ref.supabase.co"
key = "your-anon-public-key"

# ── Anthropic API (powers the AI Monitoring Brief tab) ──────────────────────
# Get your key from: console.anthropic.com → API Keys
#
[anthropic]
api_key = "sk-ant-your-key-here"

# ── App password (protects the public URL) ───────────────────────────────────
[app]
password = "choose-a-strong-password"
